<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:template="/conf/ifb/settings/wcm/templates/ifb-landing-page"
        jcr:primaryType="cq:PageContent"
        jcr:title="Home"
        pageTitle="IFB Team Hub"
        sling:resourceType="ifb/components/page">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="ifb/components/container"
            layout="responsiveGrid">
            <main
                jcr:primaryType="nt:unstructured"
                sling:resourceType="ifb/components/container"
                layout="responsiveGrid">
                <content
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="ifb/components/container"
                    layout="responsiveGrid">
                    <title
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="ifb/components/title"
                        jcr:title="Welcome to IFB Team Hub"
                        type="h1"/>
                    <text
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="ifb/components/text"
                        text="&lt;p>IFB Team Hub is where you get to know the people who design, build and test our Adobe Experience Manager sites.&lt;/p>&#xa;&lt;ul>&#xa;&lt;li>&lt;b>Our Team&lt;/b>: profiles of every team member, which you can filter by role.&lt;/li>&#xa;&lt;li>&lt;b>Live weather&lt;/b>: current conditions at our Pune office.&lt;/li>&#xa;&lt;/ul>"
                        textIsRich="true"/>
                    <button
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="ifb/components/button"
                        jcr:title="Meet the Team"
                        linkURL="/content/ifb/us/en/our-team"/>
                    <cityweather
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="ifb/components/cityweather"
                        city="Pune"
                        heading="Weather at our Pune office"/>
                </content>
            </main>
        </root>
    </jcr:content>
</jcr:root>
